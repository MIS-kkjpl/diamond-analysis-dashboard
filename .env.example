# Copy to .env and fill in. Never commit .env.

# ERP login (all ERP pipelines)
ERP_USERNAME=
ERP_PASSWORD=
# The fixed X-key header value
ERP_API_KEY=
# Optional, defaults to 2665
ERP_ROLE_CODE=2665

# PostgreSQL server (shared by all accounts below)
DIIS_DB_HOST=localhost
DIIS_DB_PORT=5432
# Admin account: used ONLY by python -m kkj.db.setup
DIIS_DB_USER=postgres
DIIS_DB_PASSWORD=

# Pipeline database and accounts
ERP_DB_NAME=kkj_erp_stock
ERP_DB_USER=erp_etl
ERP_DB_PASSWORD=
PBI_DB_USER=powerbi_reader
PBI_DB_PASSWORD=
# Dashboard account: reads all schemas, writes only schema config
APP_DB_USER=dashboard_app
APP_DB_PASSWORD=

# Stockwise sign-in (optional; these are the defaults)
# Signed out after this many hours without use, and after this many days in any case
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
# Set to true once the app is served over HTTPS (the browser then sends the cookie only over HTTPS)
COOKIE_SECURE=false

# Backups before each refresh (optional; these are the defaults)
# PG_DUMP=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
# BACKUP_DIR=<folder next to the project>\db_backups

# Port the app listens on (optional; default 8600)
# WEB_PORT=8600
